local function updateWS(input)
	local pos = math.clamp((input.Position.X - WSTrack.AbsolutePosition.X) / WSTrack.AbsoluteSize.X, 0, 1)
	local val = math.floor(16 + (200 - 16) * pos)
	WSFill.Size = UDim2.new(pos, 0, 1, 0)
	WSValueLabel.Text = tostring(val)
	currentWalkSpeed = val
	if LocalPlayer.Character and LocalPlayer.Character:FindFirstChildOfClass("Humanoid") then
		LocalPlayer.Character:FindFirstChildOfClass("Humanoid").WalkSpeed = val
	end
end

