-- MANAJEMEN PENYIMPANAN FILE TELEPORT JSON
local placeId = tostring(game.PlaceId)
local folderName = "DarkModernUI"
local fileName = folderName .. "/TeleportData.json"

local function initStorage()
	if isfolder and not isfolder(folderName) and makefolder then
		makefolder(folderName)
	end
end

local function loadAllMapData()
	initStorage()
	if readfile and isfile and isfile(fileName) then
		local success, result = pcall(function()
			return HttpService:JSONDecode(readfile(fileName))
		end)
		if success and type(result) == "table" then
			return result
		end
	end
	return {}
end

local function saveWaypointsToFile()
	initStorage()
	if writefile then
		local allData = loadAllMapData()
		allData[placeId] = {}
		
		for name, cf in pairs(savedWaypoints) do
			allData[placeId][name] = {cf.X, cf.Y, cf.Z}
		end
		
		pcall(function()
			writefile(fileName, HttpService:JSONEncode(allData))
		end)
	end
end

