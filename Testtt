-- UPDATE CROSSHAIR SCANNING EVERY FRAME
connections["TargetTP_Scanner"] = RunService.RenderStepped:Connect(function()
	if not isTargetTPActive then return end

	local camera = workspace.CurrentCamera
	if not camera then return end

	-- Sembunyikan semua tulisan [ Target ] pada BillboardGui Part
	for part, info in pairs(globalActiveESPs) do
		if info.TargetText then
			info.TargetText.Visible = false
		end
	end

	local viewportCenter = Vector2.new(camera.ViewportSize.X / 2, camera.ViewportSize.Y / 2)
	local unitRay = camera:ViewportPointToRay(viewportCenter.X, viewportCenter.Y)

	local raycastParams = RaycastParams.new()
	raycastParams.FilterType = Enum.RaycastFilterType.Exclude
	if LocalPlayer.Character then
		raycastParams.FilterDescendantsInstances = {LocalPlayer.Character}
	end

	local rayResult = workspace:Raycast(unitRay.Origin, unitRay.Direction * 1000, raycastParams)
	local hitInstance = rayResult and rayResult.Instance

	local closestPart = nil
	local shortestCharDistance = math.huge

	-- 1. Deteksi Fisik Langsung via Raycast
	if hitInstance then
		for part, info in pairs(globalActiveESPs) do
			if part and part:IsDescendantOf(workspace) then
				if hitInstance == part or hitInstance:IsDescendantOf(part) or part:IsAncestorOf(hitInstance) then
					closestPart = part
					break
				end
			end
		end
	end

	-- 2. Radius Toleransi jika Raycast Meleset Sedikit
	if not closestPart then
		for part, info in pairs(globalActiveESPs) do
			if part and part:IsDescendantOf(workspace) then
				local screenPos, onScreen = camera:WorldToViewportPoint(part.Position)
				if onScreen then
					local distToCenter = (Vector2.new(screenPos.X, screenPos.Y) - viewportCenter).Magnitude
					if distToCenter <= 150 then
						if LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
							local charDist = (LocalPlayer.Character.HumanoidRootPart.Position - part.Position).Magnitude
							if charDist < shortestCharDistance then
								shortestCharDistance = charDist
								closestPart = part
							end
						end
					end
				end
			end
		end
	end

	currentLockedTarget = closestPart

	-- Munculkan tulisan [ Target ] di BillboardGui Part yang sedang diincar
	if currentLockedTarget and globalActiveESPs[currentLockedTarget] then
		local info = globalActiveESPs[currentLockedTarget]
		if info.TargetText then
			info.TargetText.Visible = true
		end
	end
end)
